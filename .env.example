# URL pública do site (usada nos links de compartilhamento do WhatsApp/redes)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Envio dos leads do formulário por e-mail (https://resend.com)
# Sem estas três variáveis o lead ainda é registrado no log do servidor.
RESEND_API_KEY=
LEAD_EMAIL_TO=seuemail@dominio.com.br
LEAD_EMAIL_FROM=site@seudominio.com.br
